{
  "name": "suas",
  "version": "0.1.0",
  "private": true,
  "description": "SUAS implementation — conforms to SUAS-specs released stack 0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "SUAS_SKIP_TEST_DB_SETUP=true vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e:staging": "playwright test",
    "test:e2e:staging:public": "playwright test --grep @public",
    "test:watch": "vitest",
    "dev": "node --env-file=.env --import tsx/esm --watch src/main.ts",
    "local:start": "bash scripts/start-local.sh",
    "demo:local:veteran": "node --env-file=.env --import tsx/esm scripts/local-demo-browser.ts veteran",
    "demo:local:responder": "node --env-file=.env --import tsx/esm scripts/local-demo-browser.ts responder",
    "demo:local:admin": "node --env-file=.env --import tsx/esm scripts/local-demo-browser.ts admin",
    "worker:dev": "npx wrangler dev",
    "start": "node dist/main.js",
    "migrate": "node --env-file=.env --import tsx/esm src/cli/migrate.ts",
    "provenance": "node --env-file=.env --import tsx/esm src/cli/provenance.ts",
    "seed": "node --env-file=.env --import tsx/esm src/cli/seed-local.ts",
    "seed:staging:sessions": "node --import tsx/esm src/cli/seed-staging-sessions.ts",
    "seed:staging:recovery": "node --import tsx/esm src/cli/seed-recovery-fixtures.ts",
    "auth:staging:provision": "node --import tsx/esm src/cli/provision-staging-auth-users.ts",
    "jobs:work": "node --env-file=.env --import tsx/esm src/cli/job-worker.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run staging:contract && npm run test && npm run openapi:check",
    "openapi:check": "tsx scripts/check-openapi-drift.ts",
    "staging:contract": "tsx scripts/check-synthetic-staging-contract.ts",
    "evidence:staging:browser-auth": "tsx scripts/staging-browser-auth-evidence.ts",
    "evidence:preflight": "tsx scripts/synthetic-staging-evidence-invariants.ts",
    "load:synthetic": "tsx scripts/synthetic-load-harness.ts",
    "migrate:rehearse": "tsx scripts/migration-restore-rehearsal.ts",
    "settle:check": "tsx scripts/check-spec-018-settlement.ts",
    "privacy:deletion-drill": "tsx scripts/deletion-drill.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.11.10",
    "eslint": "^9.18.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.11"
  }
}
