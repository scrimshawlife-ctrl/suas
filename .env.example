# SUAS environment template — safe placeholders only
# Canonical contract: SUAS-specs/ENVIRONMENT.md v0.9.0
#
# Never commit a real .env, provider credentials, or production data
# (ENVIRONMENT.md §6-§7). Copy this file to .env for local work.

SUAS_ENV=LOCAL
SUAS_SPEC_VERSION=0.9.0
SUAS_RELEASE_MANIFEST=RELEASE_MANIFEST-0.9.0.md
SUAS_ALLOW_REAL_EXTERNAL_EFFECTS=false

# Non-secret deployment target for browser acceptance or seed-output hints.
# Set only after an owner provisions an independently owned SUAS synthetic-
# STAGING Cloudflare account/subdomain or custom hostname. Do not use a host
# belonging to another product/account. No default is intentional.
SUAS_E2E_BASE_URL=
SUAS_WORKER_BASE_URL=

# Persistence — local/test implementation value only; never commit credentials.
# This URL is for the Node CLI (`npm run migrate`, `npm run dev`). On Cloudflare
# Workers the request path reads the Hyperdrive pooled string instead. Never
# put a Neon unpooled URL or Hyperdrive connection string in wrangler.jsonc.
DATABASE_URL=postgresql://suas:suas@localhost:5432/suas_local
DATABASE_POOL_MAX=5
# TLS to Postgres: disable (LOCAL/TEST) or verify (checks the server certificate
# and host name). With verify, keep ssl* parameters out of DATABASE_URL.
# DATABASE_SSL_CA_FILE is an optional PEM bundle path, e.g. the AWS RDS global
# bundle shipped next to the deployed code.
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=
SUAS_MIGRATIONS_MODE=validate
# D-053 reset of the rewritten baseline. Leave both unset. Reset runs only when
# the database name or the full URL is listed here AND the database name
# contains the marker. Existing non-disposable databases cannot be upgraded in
# place and must not be reset. There are no down migrations.
SUAS_MIGRATION_RESET_ALLOWLIST=
SUAS_MIGRATION_RESET_SYNTHETIC_MARKER=

# Session/auth implementation secret. REQUIRED in every environment class:
# authentication is an enabled capability and this keys challenge and session
# credential hashing. Minimum 32 characters. Ships empty on purpose — generate
# your own and keep it out of git:
#   openssl rand -hex 32
SUAS_SESSION_SECRET=
SUAS_BROWSER_AUTH_MODE=disabled
SUAS_BROWSER_TENANT_ID=

# D-035 sandbox-only VA OAuth evidence. Disabled by default and forbidden in
# PRODUCTION. Set true only in an independently provisioned sandbox environment.
# Keep client secret out of git and use platform secret storage. Public JWK JSON
# must be an array. No authorization codes, tokens, or VA payloads are stored.
SUAS_VA_SANDBOX_OAUTH_ENABLED=false
SUAS_VA_SANDBOX_OAUTH_CLIENT_ID=
SUAS_VA_SANDBOX_OAUTH_CLIENT_SECRET=
SUAS_VA_SANDBOX_OAUTH_AUTHORIZATION_ENDPOINT=
SUAS_VA_SANDBOX_OAUTH_REDIRECT_URI=
SUAS_VA_SANDBOX_OAUTH_TOKEN_ENDPOINT=
SUAS_VA_SANDBOX_OAUTH_STATUS_ENDPOINT=
SUAS_VA_SANDBOX_OAUTH_ISSUER=
SUAS_VA_SANDBOX_OAUTH_AUDIENCE=
SUAS_VA_SANDBOX_OAUTH_JWKS_JSON=

# D-004 selects Resend as the sole external EMAIL provider. LOCAL uses sink or
# fake. STAGING may select resend for enrolled, owner-approved test identities.
# Keep credentials out of committed files and use platform secret storage.
# SUAS_EMAIL_MODE=ses (V1_PROJECT_PLAN.md §4.1) sends through Amazon SES using the
# AWS default credential chain; it needs SUAS_AWS_REGION and SUAS_EMAIL_FROM and is
# forbidden in LOCAL and TEST, like resend.
SUAS_EMAIL_MODE=sink
SUAS_SMS_MODE=sink
RESEND_API_KEY=
SUAS_EMAIL_FROM=

# AWS-backed capability ports (V1_PROJECT_PLAN.md §2.2, §4.1). No AWS keys are ever
# configured here; the AWS default credential chain supplies them.
# Modes: disabled (default) | fake | bedrock / s3. Real modes are forbidden in
# LOCAL and TEST. fake is refused in PRODUCTION. Bedrock with no model id reports
# the capability unavailable (the model is not chosen yet).
SUAS_AWS_REGION=
SUAS_MODEL_INFERENCE_MODE=disabled
SUAS_BEDROCK_MODEL_ID=
SUAS_OBJECT_STORAGE_MODE=disabled
SUAS_S3_BUCKET=
# ID scan + selfie check: disabled (default) | fake. No real provider is chosen.
# fake is refused outside LOCAL and TEST, including STAGING (D-052).
SUAS_ID_VERIFICATION_MODE=disabled
# Public self sign-up. enabled is refused outside LOCAL and TEST.
SUAS_PUBLIC_SIGN_UP=disabled
# Addresses the STAGING provision command may create. Not an admission list.
# Addresses must be synthetic. The demo address is not added unless it is listed.
SUAS_STAGING_AUTH_EMAILS=
# Explicit tenant-id:user-id pairs STAGING server auth admits. Empty admits nobody,
# including the demo account and any previously issued session or challenge.
SUAS_STAGING_FIXTURE_REGISTRY=
# Chat live updates: disabled (default) | local (LOCAL/TEST only) | apigw (API Gateway WebSocket).
# Messages are sent and listed over REST in every mode.
SUAS_CHAT_PUSH_MODE=disabled
# apigw: https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
SUAS_CHAT_WS_ENDPOINT=
# apigw only, optional: wss:// URL clients open instead of the execute-api host
# (for example a custom domain mapped to the same stage). Leave empty to use the endpoint above.
SUAS_CHAT_WS_PUBLIC_URL=
# local: port of the dev WebSocket server (default 3001)
SUAS_CHAT_LOCAL_WS_PORT=

# MVP service adapters: manual/fake/disabled, plus uber_guest_rides for
# transportation when explicitly configured. Manual/fake remain valid first-class paths.
SUAS_TRANSPORTATION_ADAPTER_MODE=fake
SUAS_SHELTER_ADAPTER_MODE=fake
SUAS_FOOD_ADAPTER_MODE=fake
SUAS_PEER_SUPPORT_ADAPTER_MODE=manual

# Uber Guest Rides adapter-local credentials. Required only when
# SUAS_TRANSPORTATION_ADAPTER_MODE=uber_guest_rides. Leave blank in committed examples.
# Webhook ingress is not mounted by this release; adapter primitives verify HMAC
# and translate payloads, while unknown outcomes stay blocked for reconciliation/polling.
SUAS_UBER_GUEST_RIDES_CLIENT_ID=
SUAS_UBER_GUEST_RIDES_CLIENT_SECRET=
SUAS_UBER_GUEST_RIDES_TOKEN_URL=
SUAS_UBER_GUEST_RIDES_API_BASE_URL=
SUAS_UBER_GUEST_RIDES_WEBHOOK_SECRET=
SUAS_AMADEUS_LODGING_CLIENT_ID=
SUAS_AMADEUS_LODGING_CLIENT_SECRET=
SUAS_AMADEUS_LODGING_TOKEN_URL=
SUAS_AMADEUS_LODGING_API_BASE_URL=

# D-011 released sv-001 as implementation-authoritative. TEST/CI stay on
# fixture; ENVIRONMENT.md §3 still does not release a production scoring mode.
# Safety-copy TEST/CI default stays placeholder_test_only (D-012).
SUAS_SUPPORT_SIGNAL_MODE=fixture
SUAS_SAFETY_COPY_MODE=placeholder_test_only
SUAS_SENSITIVE_AGGREGATE_REPORTING=disabled

# Implementation-owned mechanism (not released product semantics).
# Optional; defaults are 127.0.0.1:3000 and info (silent under SUAS_ENV=TEST).
SUAS_HTTP_HOST=127.0.0.1
SUAS_HTTP_PORT=3000
SUAS_LOG_LEVEL=info
# "enabled" gives demo@example.invalid the fixed sign-in code 123456.
# LOCAL also needs a local database. Synthetic STAGING allows it only on the
# Worker. Config rejects "enabled" for TEST and PRODUCTION.
SUAS_DEMO_FIXED_CODE=disabled

# Cross-origin access (SUAS-specs D-038, released in 0.7.0). Comma-separated EXACT origins
# that may call this server cross-origin: CORS responses, preflight, and browser
# form/fetch writes. No wildcard. https only, except http://localhost,
# http://127.0.0.1, or http://[::1] (any port) in LOCAL and TEST. Empty or unset
# means no CORS headers, and browser writes must be same-origin. Max 20 entries.
# No wildcard (also %2a), no empty host labels, and no loopback names or IP
# literals in STAGING or PRODUCTION. A build pinned below spec 0.7.0 rejects any
# non-empty value at startup in every SUAS_ENV, TEST included. List owner-controlled
# origins only: each one gets full /app session read and write, and a non-empty
# value makes the /app cookie SameSite=None (Strict while empty).
# Example: SUAS_CORS_ALLOWED_ORIGINS=https://app.example.org,http://localhost:5173
SUAS_CORS_ALLOWED_ORIGINS=

# Build provenance, normally stamped by CI rather than set by hand
# (ENVIRONMENT.md §8). Left blank locally; build-info then reports
# provenance_complete=false instead of implying a stamped build.
SUAS_BUILD_COMMIT=
SUAS_BUILD_TIMESTAMP=
